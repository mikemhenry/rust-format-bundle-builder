#!/bin/sh
set -eu

ARCHIVE_SHA256='6352c6be19eb2daaa012062e31bd8b1b5b7f1027dfc311a0942083dc5de07039'
CARGO_SHA256='5a16ac90925b488d889cde417f0cf813289acf0dd13fa61671e0d869915a4762'
CARGO_FMT_SHA256='29355c1503fe3be23baa7e98ea0cdbf00236d9fabd809e31dea4011929d5fc56'
RUSTFMT_SHA256='37de000cbb42d8f4eb4c6e1aeecc9a87b364e051decd815966ca70563753b98c'
LIBGCC_SHA256='fc9d43b2f6c20e53b009238f767c5b949d202389e20de9e202ea684b4ba3729a'

fail() {
    printf 'rust-format: %s\n' "$*" >&2
    exit 1
}

[ "$#" -gt 0 ] || fail 'usage: with-rust-format <command> [args...]'

os=$(uname -s 2>/dev/null || true)
arch=$(uname -m 2>/dev/null || true)
[ "$os" = 'Linux' ] || fail "unsupported OS: ${os:-unknown}; expected Linux"
case "$arch" in
    x86_64|amd64) ;;
    *) fail "unsupported architecture: ${arch:-unknown}; expected x86_64" ;;
esac

script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
skill_dir=$(CDPATH= cd "$script_dir/.." && pwd)
archive="$skill_dir/assets/rust-format-tools.tar.xz"
[ -f "$archive" ] || fail "missing payload: $archive"

actual_archive_sha=$(sha256sum "$archive" | awk '{print $1}')
[ "$actual_archive_sha" = "$ARCHIVE_SHA256" ] || \
    fail "payload SHA-256 mismatch: expected $ARCHIVE_SHA256, got $actual_archive_sha"

if [ -n "${XDG_CACHE_HOME:-}" ]; then
    cache_base=$XDG_CACHE_HOME
elif [ -n "${HOME:-}" ]; then
    cache_base=$HOME/.cache
else
    cache_base=/tmp
fi

cache_parent="$cache_base/chatgpt-rust-format"
cache_dir="$cache_parent/$ARCHIVE_SHA256"
payload_dir="$cache_dir/rust-format-tools"
ready="$cache_dir/.ready"

prepare_payload() {
    mkdir -p "$cache_parent" 2>/dev/null || {
        cache_parent="/tmp/chatgpt-rust-format-$(id -u 2>/dev/null || printf 'user')"
        cache_dir="$cache_parent/$ARCHIVE_SHA256"
        payload_dir="$cache_dir/rust-format-tools"
        ready="$cache_dir/.ready"
        mkdir -p "$cache_parent" || fail "cannot create cache directory: $cache_parent"
    }

    if [ -f "$ready" ]; then
        return
    fi

    tmp="$cache_parent/.extract-$ARCHIVE_SHA256-$$"
    rm -rf "$tmp"
    mkdir -p "$tmp"
    tar -xJf "$archive" -C "$tmp" || {
        rm -rf "$tmp"
        fail 'failed to extract formatter payload'
    }

    root="$tmp/rust-format-tools"
    [ -f "$root/bin/cargo" ] || fail 'payload missing bin/cargo'
    [ -f "$root/bin/cargo-fmt" ] || fail 'payload missing bin/cargo-fmt'
    [ -f "$root/bin/rustfmt" ] || fail 'payload missing bin/rustfmt'
    [ -f "$root/lib/libgcc_s.so.1" ] || fail 'payload missing lib/libgcc_s.so.1'

    check_file() {
        expected=$1
        file=$2
        actual=$(sha256sum "$file" | awk '{print $1}')
        [ "$actual" = "$expected" ] || fail "extracted file SHA-256 mismatch: $file"
    }

    check_file "$CARGO_SHA256" "$root/bin/cargo"
    check_file "$CARGO_FMT_SHA256" "$root/bin/cargo-fmt"
    check_file "$RUSTFMT_SHA256" "$root/bin/rustfmt"
    check_file "$LIBGCC_SHA256" "$root/lib/libgcc_s.so.1"
    chmod u+rx "$root/bin/cargo" "$root/bin/cargo-fmt" "$root/bin/rustfmt"

    rm -rf "$cache_dir"
    mv "$tmp" "$cache_dir" || {
        rm -rf "$tmp"
        fail "failed to install formatter payload in cache: $cache_dir"
    }
    printf '%s\n' "$ARCHIVE_SHA256" > "$ready"
}

prepare_payload

[ -x "$payload_dir/bin/cargo" ] || fail 'cached cargo is not executable'
[ -x "$payload_dir/bin/cargo-fmt" ] || fail 'cached cargo-fmt is not executable'
[ -x "$payload_dir/bin/rustfmt" ] || fail 'cached rustfmt is not executable'

PATH="$payload_dir/bin${PATH:+:$PATH}"
LD_LIBRARY_PATH="$payload_dir/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PATH LD_LIBRARY_PATH

exec "$@"
